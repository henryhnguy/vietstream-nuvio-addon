# Cấu hình mẫu — copy thành .env (hoặc set biến môi trường khi deploy)

PORT=7001
# Chỉ bật một số nguồn (bỏ comment nếu cần)
# PROVIDERS=kkphim,nguonc,phim4k,vnstream,ophim

# Nguồn nào đi qua HLS proxy chống 403: danh sách / * / none
# PROXY_PROVIDERS=nguonc

# Đổi domain khi nguồn chuyển host
# KKPHIM_API_URL=https://phimapi.com
# NGUONC_API_URL=https://phim.nguonc.com/api
# PHIM4K_API_URL=https://vsmov.com/api
# OPHIM_API_URL=https://www.ophim.live
# VNSTREAM_API_URL=https://egluy2hhb21vaw5ndw9pbmhl.darkbytes.xyz/api/v1
# VNSTREAM_SITE_URL=https://cobephim.biz

# TIMEOUT=8000
# TIMEOUT_STREAM=9000
# DEBUG=1
